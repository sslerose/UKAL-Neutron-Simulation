# Visualization macro for publication-quality detector cross-section
# STEP 1: Preview with interactive Qt viewer

# Initialize kernel
/run/initialize

# Start with interactive Qt viewer for preview
/vis/open TSGQt

# Disable auto refresh for setup
/vis/viewer/set/autoRefresh false
/vis/verbose errors

# Draw geometry
/vis/drawVolume

# ============================================
# CAMERA POSITIONING
# ============================================

# View from positive x, positive y, positive z (looks into the cut)
/vis/viewer/set/viewpointVector 1.2 -0.8 0.6

# ============================================
# LIGHTING AND RENDERING
# ============================================

# Set lighting to match viewpoint for best contrast
/vis/viewer/set/lightsVector 1 1 -1

# Surface rendering with edges for clarity
/vis/viewer/set/style surface
/vis/viewer/set/auxiliaryEdge true
/vis/viewer/set/lineSegmentsPerCircle 100

# ============================================
# SCENE ELEMENTS
# ============================================

# Add coordinate axes at origin (optional - comment out if not needed)
#/vis/scene/add/axes 0 0 0 20 mm

# Make container volumes invisible
/vis/geometry/set/visibility World 0 false
/vis/geometry/set/visibility AssemblyMother 0 false
/vis/geometry/set/visibility InnerAssembly 0 false

# ============================================
# COLOR SCHEME - Publication friendly
# ============================================

# Aluminum holder - bronze/tan
/vis/geometry/set/colour Holder 0 0.70 0.55 0.30 1.0

# Stainless steel can - dark gray
/vis/geometry/set/colour Can 0 0.40 0.40 0.40 1.0
/vis/geometry/set/colour CanCap 0 0.40 0.40 0.40 1.0

# Rubber - yellow-orange with transparency
/vis/geometry/set/colour Rubber 0 1.0 0.65 0.0 0.6

# Teflon - white/light gray with transparency
/vis/geometry/set/colour Teflon 0 0.95 0.95 0.95 0.7

# Detector (scintillator) - cyan/light blue with transparency
/vis/geometry/set/colour Detector 0 0.4 0.8 1.0 0.7

# PMT - blue with transparency
/vis/geometry/set/colour PMT 0 0.2 0.4 0.8 0.6

# ============================================
# VIEWPORT AND ZOOM
# ============================================

# Zoom to fit detector nicely in frame
/vis/viewer/zoom 1.5

# Set background to white for publication
/vis/viewer/set/background 1 1 1

# Re-enable auto refresh to see the result
/vis/viewer/set/autoRefresh true
/vis/verbose warnings

# ============================================
# At this point:
# 1. Check the view in the Qt window
# 2. Manually adjust with mouse if needed
# 3. When satisfied, run vis_export.mac
# ============================================

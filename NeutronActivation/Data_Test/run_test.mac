# ---------------------------------------- #
# Test macro file for activation measurements
#
# Places Fe-60 absorber 5 mm from origin and
#   bombards with neutrons from SimLiT over
#   15 minute exposure
# ---------------------------------------- #

# Set verbose levels
/run/verbose 1
/event/verbose 0
/tracking/verbose 0

# Print progress handled automatically

# Initialize
/run/initialize

# Set a very high time threshold to allow all decays to happen
/process/had/rdm/thresholdForVeryLongDecayTime 1.0e+60 year

# Set parameters
/neutronAct/gun/useSimLiT true
/neutronAct/gun/exposureTime 900 s
/neutronAct/abs/setAbsorberDistance 5 mm
/neutronAct/abs/setAbsorberMaterial fe60 27 60 8.451 g/cm3
/neutronAct/setWorldMaterial air
/neutronAct/det/setDetectorDistance 5 cm

/analysis/h1/set 3 100 0 900 s
/analysis/setFileName Fe60_Test

# Run events
/run/beamOn 1000000
